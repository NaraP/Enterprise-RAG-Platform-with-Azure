{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Azure": "Warning"
    }
  },
  "ConnectionStrings": {
    "ApplicationDb": "Server=tcp:<your-server>.database.windows.net,1433;Database=RagPlatform;Authentication=Active Directory Managed Identity;"
  },
  "Azure": {
    "StorageAccountUri": "https://<your-storage-account>.blob.core.windows.net",
    "ServiceBusNamespace": "<your-namespace>.servicebus.windows.net",
    "SearchEndpoint": "https://<your-search-service>.search.windows.net",
    "OpenAiEndpoint": "https://<your-openai-resource>.openai.azure.com",
    "OpenAiEmbeddingDeployment": "text-embedding-3-small"
  },
  "ApplicationInsights": {
    "ConnectionString": "<your-app-insights-connection-string>"
  }
}
